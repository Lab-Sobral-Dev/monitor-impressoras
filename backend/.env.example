# Servidor
PORT=3000

# Banco de dados
# Docker: /data/banco.db  |  Dev local: ./banco.db
DATABASE_PATH=/data/banco.db

# Senha da área de estoque
ESTOQUE_SENHA=troque-este-token

# CORS — domínio de onde o frontend será servido
# Deixe em branco para desativar restrição (não recomendado em produção)
ALLOWED_ORIGIN=https://seudominio.com

# Acoplamento ao Gestão (gestao-sbr) — Protocolo de Acoplamento
# Segredo compartilhado com o lado do Gestão (produtos.ts / env DOCKING_SECRET_MONITOR_IMPRESSORAS).
# Ausente = /api/auth/sso responde 503 (produto "não configurado"), nunca falha silenciosamente.
DOCKING_SECRET_MONITOR_IMPRESSORAS=
# Pra onde redirecionar quem acessar este sistema direto (fora do iframe do Gestão).
GESTAO_URL_TINTA_BRANCA=https://gestao.laboratoriosobral.com.br/ti/monitor-impressoras

# Auditoria de impressão por usuário — consome o page_log do CUPS via endpoint
# HTTP exposto pelo PRINTSRV (nexus-labsobral, .216). Ausente = coleta desativada,
# nunca falha silenciosamente com erro de rede/timeout.
PAGELOG_API_URL=http://192.86.221.216:8631
PAGELOG_API_TOKEN=

# Disponibilidade nos relatórios: expediente (seg–sex) e fuso horário
# Faixas de horas separadas por vírgula; "08-12,14-17" = 8h às 12h e 14h às 17h
EXPEDIENTE=08-12,14-17
FUSO_HORARIO_HORAS=-3
